<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".recordsdetails"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/btnback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:textSize="18sp"
        android:textColor="#233EEC"
        android:padding="5dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Record Details"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Title : "
        android:textSize="22sp"
        android:layout_marginTop="18dp"
        android:id="@+id/vtitle"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category : "
        android:textSize="22sp"
        android:layout_marginTop="18dp"
        android:id="@+id/vcategory"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Doctor Name : "
        android:textSize="22sp"
        android:layout_marginTop="18dp"
        android:id="@+id/vdrname"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hospital Name : "
        android:textSize="22sp"
        android:layout_marginTop="18dp"
        android:id="@+id/vhospname"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date : "
        android:textSize="22sp"
        android:layout_marginTop="18dp"
        android:id="@+id/vdate"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Condition : "
        android:textSize="22sp"
        android:layout_marginTop="18dp"
        android:id="@+id/vcond"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="View File"
        android:textColor="@android:color/white"
        android:backgroundTint="#233EEC"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="25dp"
        android:id="@+id/btnview"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Share Record"
        android:textColor="@android:color/white"
        android:backgroundTint="#233EEC"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="25dp"
        android:id="@+id/btnshare"/>


</LinearLayout>